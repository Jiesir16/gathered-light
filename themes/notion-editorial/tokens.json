{
  "$schema": "../tokens.schema.json",
  "meta": {
    "name": "Notion Editorial",
    "mode": "light",
    "source": "awesome-design-md/notion"
  },
  "color": {
    "bg": "#ffffff",
    "bg-alt": "#f6f5f4",
    "surface": "#ffffff",
    "border": "rgba(0,0,0,0.1)",
    "text": "rgba(0,0,0,0.95)",
    "text-muted": "#615d59",
    "text-subtle": "#a39e98",
    "accent": "#0075de",
    "accent-hover": "#005bab",
    "on-accent": "#ffffff",
    "success": "#1aae39",
    "warning": "#dd5b00",
    "danger": "#dd0000"
  },
  "font": {
    "display": "\"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "body": "\"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "mono": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, monospace"
  },
  "type": {
    "display-size": "64px",
    "display-weight": 700,
    "display-tracking": "-2.125px",
    "display-line": 1.0,
    "h2-size": "26px",
    "h2-weight": 700,
    "h2-tracking": "-0.625px",
    "h2-line": 1.23,
    "body-size": "16px",
    "body-weight": 400,
    "body-line": 1.5,
    "caption-size": "14px"
  },
  "radius": {
    "input": "4px",
    "card": "12px",
    "pill": "9999px"
  },
  "space": {
    "unit": "8px",
    "section-y": "80px",
    "gutter": "32px",
    "max-width": "1200px"
  },
  "shadow": {
    "card": "rgba(0,0,0,0.04) 0px 4px 18px, rgba(0,0,0,0.027) 0px 2.025px 7.85px, rgba(0,0,0,0.02) 0px 0.8px 2.93px, rgba(0,0,0,0.01) 0px 0.175px 1.04px",
    "deep": "rgba(0,0,0,0.01) 0px 1px 3px, rgba(0,0,0,0.02) 0px 3px 7px, rgba(0,0,0,0.02) 0px 7px 15px, rgba(0,0,0,0.04) 0px 14px 28px, rgba(0,0,0,0.05) 0px 23px 52px"
  }
}
