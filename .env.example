# 复制为 .env 并按需修改；与 config/default.toml 同一份配置树，env 优先级更高。
# 嵌套字段用双下划线分隔：APP_DATABASE__URL → database.url
#
# 生产部署：先在服务器上生成强 JWT secret：
#   echo "APP_JWT__SECRET=$(openssl rand -base64 48)" >> .env

# ───── 应用 ─────────────────────────────────────────────────────────
APP_ENV=development                                  # production / development
APP_BIND_ADDR=0.0.0.0:8080                           # 生产建议绑 127.0.0.1:8080，由 nginx 代理出去

# ───── PostgreSQL ──────────────────────────────────────────────────
APP_DATABASE__URL=postgres://postgres:postgres@localhost:5432/gathered_light
# docker compose 起 PG 时也要同步改 .env 里的 POSTGRES_PASSWORD（被 compose 引用）
POSTGRES_PASSWORD=postgres

# ───── Redis ───────────────────────────────────────────────────────
APP_REDIS__URL=redis://localhost:6379/0

# ───── 对象存储（S3 兼容；dev 用 MinIO，生产用腾讯云 COS / AWS S3）─────
APP_S3__ENDPOINT=http://localhost:9000               # 生产例：https://cos.ap-shanghai.myqcloud.com
# 公开图片访问域名。填 CDN/自定义域名后，public 图片 URL 会变成 https://img.example.com/variants/...
# 不要把 APP_S3__ENDPOINT 改成 CDN 域名；endpoint 要保留给签名、HEAD、ACL 等 S3 API。
APP_S3__PUBLIC_BASE_URL=                             # 生产例：https://img.example.com
APP_S3__REGION=us-east-1                             # 生产例：ap-shanghai
APP_S3__BUCKET=gathered-light                        # ⚠ COS 桶名带 appid：bucket-1300xxxxxx
APP_S3__ACCESS_KEY=minioadmin                        # 生产建子用户 + 仅本桶授权
APP_S3__SECRET_KEY=minioadmin

# ───── JWT（HS256，只需 secret；不再用密钥对文件）────────────────────
# dev 用下面这个占位也行；生产必须 openssl rand -base64 48 生成强值
APP_JWT__SECRET=dev-secret-change-me

# ───── 日志 ─────────────────────────────────────────────────────────
# 生产建议：RUST_LOG=info,sea_orm=warn,sqlx=warn,hyper=warn,tower_http=info
RUST_LOG=info,sea_orm=debug,sqlx=warn,hyper=warn,tower_http=info
